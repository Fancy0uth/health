{
  "healththread_read_source": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://healththread.local/schemas/healththread_read_source.json",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "source_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "source_id"
    ]
  },
  "healththread_retrieve_context": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://healththread.local/schemas/healththread_retrieve_context.json",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 1000
      },
      "episode_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "minItems": 0,
        "maxItems": 100
      }
    },
    "required": []
  },
  "healththread_stage_candidates": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://healththread.local/schemas/healththread_stage_candidates.json",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "candidates": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/candidate"
        },
        "minItems": 0,
        "maxItems": 100
      },
      "base_profile_revision": {
        "type": "integer",
        "minimum": 1
      },
      "operation_key": {
        "type": "string",
        "minLength": 16,
        "maxLength": 128
      },
      "record_dialogue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "questions": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "missing_fields": {
            "type": "array",
            "maxItems": 9,
            "uniqueItems": true,
            "items": {
              "enum": [
                "症状表现",
                "开始时间",
                "身体部位",
                "频率",
                "持续时间",
                "程度",
                "影响",
                "用药",
                "过敏"
              ]
            }
          },
          "summary": {
            "type": "string",
            "maxLength": 20000,
            "description": "Natural summary of supported current patient details, retaining uncertainty and corrections. Does not replace exact candidate evidence or assert medical verification.",
            "minLength": 1
          }
        },
        "required": [
          "questions",
          "missing_fields"
        ]
      },
      "record_source_refs": {
        "type": "array",
        "minItems": 0,
        "maxItems": 100,
        "description": "Natural record only: select currently valid health sentences from authorized indexed_sentences. Send candidates:[] and a nonempty record_dialogue.summary. Server derives exact evidence and metadata; never mix with manual candidates.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sentence_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "source_id",
            "sentence_index"
          ]
        }
      }
    },
    "required": [
      "candidates",
      "base_profile_revision",
      "operation_key"
    ],
    "$defs": {
      "evidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_text_version": {
            "type": "integer",
            "minimum": 1
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "page",
              "start",
              "end"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "source_text_version",
          "locator",
          "quote"
        ]
      },
      "effective_time": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "precision": {
            "enum": [
              "exact",
              "interval",
              "relative",
              "unknown"
            ]
          },
          "start": {
            "type": [
              "string",
              "null"
            ]
          },
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "enum": [
              null,
              "Asia/Shanghai",
              "UTC"
            ]
          },
          "anchor_source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "raw",
          "precision",
          "start",
          "end",
          "timezone",
          "anchor_source_id"
        ]
      },
      "candidate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "reported_text",
              "symptom",
              "diagnosis",
              "medication",
              "instruction",
              "allergy",
              "test",
              "observation"
            ]
          },
          "value": {
            "type": "string"
          },
          "assertion": {
            "enum": [
              "affirmed",
              "negated",
              "uncertain"
            ]
          },
          "temporal_scope": {
            "enum": [
              "current",
              "past",
              "unknown"
            ]
          },
          "effective_time": {
            "$ref": "#/$defs/effective_time"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "proposal_kind": {
            "enum": [
              "new",
              "correction",
              "retraction"
            ]
          },
          "fact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "episode_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "field",
          "value",
          "assertion",
          "temporal_scope",
          "effective_time",
          "evidence",
          "proposal_kind"
        ],
        "description": "All evidence quotes must exactly equal this candidate value; field/assertion/temporal_scope/effective_time are validated solely against that rendered value. Unrelated auxiliary evidence is rejected."
      }
    },
    "allOf": [
      {
        "if": {
          "required": [
            "record_source_refs"
          ]
        },
        "then": {
          "properties": {
            "candidates": {
              "maxItems": 0
            },
            "record_dialogue": {
              "required": [
                "summary"
              ]
            }
          },
          "required": [
            "record_dialogue"
          ]
        }
      }
    ]
  },
  "healththread_get_confirmed_instructions": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://healththread.local/schemas/healththread_get_confirmed_instructions.json",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "document_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "document_id"
    ]
  },
  "healththread_stage_result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://healththread.local/schemas/healththread_stage_result.json",
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "visit_preparation"
          },
          "payload": {
            "$ref": "#/$defs/visit_payload"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/dependency"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "operation_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "kind",
          "payload",
          "dependencies",
          "operation_key"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "care_plan"
          },
          "payload": {
            "$ref": "#/$defs/care_payload"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/dependency"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "operation_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "kind",
          "payload",
          "dependencies",
          "operation_key"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "assistant_reply"
          },
          "payload": {
            "$ref": "#/$defs/chat_payload"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/dependency"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "operation_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "kind",
          "payload",
          "dependencies",
          "operation_key"
        ]
      }
    ],
    "$defs": {
      "evidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_text_version": {
            "type": "integer",
            "minimum": 1
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "page",
              "start",
              "end"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "source_text_version",
          "locator",
          "quote"
        ]
      },
      "fact_ref": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "fact_id",
          "revision"
        ]
      },
      "source_ref": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_text_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "source_id",
          "source_text_version"
        ]
      },
      "dependency": {
        "oneOf": [
          {
            "$ref": "#/$defs/fact_ref"
          },
          {
            "$ref": "#/$defs/source_ref"
          }
        ]
      },
      "claim": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "fact_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/fact_ref"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 0,
            "maxItems": 20
          }
        },
        "required": [
          "text",
          "fact_refs",
          "evidence"
        ],
        "description": "Every submitted source quote and fact value must equal the evidence claim text. Granular claims are optional for v2 chat and visit; the server preserves authorized source links. V2 visible reply or visit speech is a separate natural synthesis. Legacy visit evidence requirements remain unchanged."
      },
      "visit_payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "speech": {
            "type": "string",
            "maxLength": 20000
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            },
            "minItems": 0,
            "maxItems": 20
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            },
            "minItems": 0,
            "maxItems": 30
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claim"
            },
            "minItems": 0,
            "maxItems": 100,
            "description": "For format_version:2 default to []; authorized source links are server-owned. Optional granular claims still require exact source evidence. Do not drop format_version during repairs."
          },
          "format_version": {
            "const": 2,
            "description": "Natural patient-facing format. Omit for legacy payloads."
          }
        },
        "required": [
          "speech",
          "questions",
          "unknowns",
          "claims"
        ]
      },
      "care_task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "instruction_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/fact_ref"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "schedule": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "text",
          "instruction_refs",
          "schedule"
        ],
        "description": "Every instruction_ref must have exactly this task text. All distinct confirmed instruction texts must be represented; identical instruction texts may share one task with their corresponding references."
      },
      "care_payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/care_task"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "tasks"
        ]
      },
      "chat_payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "speech": {
            "type": "string",
            "maxLength": 20000
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            },
            "minItems": 0,
            "maxItems": 20
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            },
            "minItems": 0,
            "maxItems": 30
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claim"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "intent": {
            "enum": [
              "greeting",
              "clarify",
              "prepare",
              "offer_visit",
              "confirm_visit",
              "offer_record",
              "confirm_record",
              "offer_both",
              "confirm_both",
              "records",
              "scope"
            ],
            "description": "offer_* means the assistant is asking the user for execution permission. Asking for permission always uses offer_*, never confirm_*. confirm_* means the current user explicitly authorized execution of a matching still-pending prior offer. If pending_action_offer is absent/null, use offer_* for an action request. Refused, deferred or superseded offers cannot authorize execution. Interpret meaning, not keywords such as confirm or yes."
          },
          "format_version": {
            "const": 2,
            "description": "Natural patient-facing format. Omit for legacy payloads."
          },
          "reply": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "description": "The complete natural assistant turn, including any focused questions. Evidence metadata is not the visible reply."
          },
          "confirmation_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "description": "Only for confirm_*: exact full current user text explicitly granting execution permission for the current pending_action_offer. Asking the assistant to confirm or agreeing with a symptom summary is not execution consent. Omit for offer_*."
          },
          "confirmation_offer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Only for confirm_*: copy the existing matching pending_action_offer.run_id exactly. Never invent an id or use an empty string. If no pending offer exists, choose offer_* and omit all confirmation fields; do not recover a refused or expired offer from history."
          },
          "confirmation_has_new_details": {
            "type": "boolean",
            "description": "False only when the consenting user turn contains no new health details or corrections; omitted means retain the source."
          }
        },
        "required": [
          "speech",
          "questions",
          "unknowns",
          "claims",
          "intent"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "format_version"
              ]
            },
            "then": {
              "required": [
                "reply"
              ]
            }
          },
          {
            "if": {
              "required": [
                "format_version",
                "intent"
              ],
              "properties": {
                "intent": {
                  "enum": [
                    "confirm_visit",
                    "confirm_record",
                    "confirm_both"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "confirmation_quote",
                "confirmation_offer_id"
              ]
            }
          }
        ]
      }
    }
  }
}
