HOST=127.0.0.1
PORT=4173
HEALTHTHREAD_DB_PATH=.runtime/healththread.sqlite
# disabled: test the shared backend without making model calls.
# agnes: use only the Agnes model configured in the AGH runtime.
AGENT_MODE=disabled
# AGH_ROOT=/absolute/path/to/agnes-harness
# AGH_HOME=/absolute/path/to/the/same/agh-home
# AGH_SOCKET_PATH=/absolute/path/to/daemon.sock
# Optional SDK transport/auth JSON, server-side only. Do not commit real credentials.
# AGH_SDK_OPTIONS_JSON={"transport":{"kind":"unix","path":"/path/to/daemon.sock"},"auth":{"kind":"local"}}
# AGH_PRESET=your-reviewed-health-preset
