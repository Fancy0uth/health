HOST=127.0.0.1
PORT=4173
HEALTHTHREAD_DB_PATH=.runtime/healththread-domain.sqlite
# agnes is the default; unavailable real dependencies fail closed.
# disabled preserves originals but blocks model analysis.
AGENT_MODE=agnes
# Explicit synthetic local authentication; no default account is provisioned.
HEALTHTHREAD_DEMO_AUTH=0
HEALTHTHREAD_DEMO_USERNAME=demo
HEALTHTHREAD_DEMO_PASSWORD=replace-with-long-synthetic-password
# Read-only pinned clean AGH source, with its dependencies installed.
AGH_ROOT=/absolute/path/to/agnes-harness
# Read-only configured account home; credentials stay here, outside product runtime.
AGH_ACCOUNT_HOME=/absolute/path/to/configured-account-home
AGH_ACCOUNT_PROFILE=local-dev
# Legacy AGH_HOME is only an alias for AGH_ACCOUNT_HOME.
# Optional product-owned release/run base. Must not be inside source/account home.
# HEALTHTHREAD_AGH_HOME=/absolute/path/to/healththread-owned-runtime
# Protect .env permissions and never commit real credentials or health data.
