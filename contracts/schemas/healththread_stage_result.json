{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healththread.local/schemas/healththread_stage_result.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "visit_preparation"
        },
        "payload": {
          "$ref": "#/$defs/visit_payload"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "operation_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      },
      "required": [
        "kind",
        "payload",
        "dependencies",
        "operation_key"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "care_plan"
        },
        "payload": {
          "$ref": "#/$defs/care_payload"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "operation_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      },
      "required": [
        "kind",
        "payload",
        "dependencies",
        "operation_key"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "assistant_reply"
        },
        "payload": {
          "$ref": "#/$defs/chat_payload"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "operation_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      },
      "required": [
        "kind",
        "payload",
        "dependencies",
        "operation_key"
      ]
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_text_version": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "page",
            "start",
            "end"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "source_text_version",
        "locator",
        "quote"
      ]
    },
    "fact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "fact_id",
        "revision"
      ]
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_text_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "source_id",
        "source_text_version"
      ]
    },
    "dependency": {
      "oneOf": [
        {
          "$ref": "#/$defs/fact_ref"
        },
        {
          "$ref": "#/$defs/source_ref"
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "fact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact_ref"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "text",
        "fact_refs",
        "evidence"
      ],
      "description": "Every submitted source quote and fact value must equal the evidence claim text. Granular claims are optional for v2 chat and visit; the server preserves authorized source links. V2 visible reply or visit speech is a separate natural synthesis. Legacy visit evidence requirements remain unchanged."
    },
    "visit_payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speech": {
          "type": "string",
          "maxLength": 20000
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 20
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 30
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 0,
          "maxItems": 100,
          "description": "For format_version:2 default to []; authorized source links are server-owned. Optional granular claims still require exact source evidence. Do not drop format_version during repairs."
        },
        "format_version": {
          "const": 2,
          "description": "Natural patient-facing format. Omit for legacy payloads."
        }
      },
      "required": [
        "speech",
        "questions",
        "unknowns",
        "claims"
      ]
    },
    "care_task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "instruction_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact_ref"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "schedule": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "text",
        "instruction_refs",
        "schedule"
      ],
      "description": "Every instruction_ref must have exactly this task text. All distinct confirmed instruction texts must be represented; identical instruction texts may share one task with their corresponding references."
    },
    "care_payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/care_task"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "explanation": {
          "type": "string"
        }
      },
      "required": [
        "tasks"
      ]
    },
    "chat_payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speech": {
          "type": "string",
          "maxLength": 20000
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 20
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 30
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "intent": {
          "enum": [
            "greeting",
            "clarify",
            "prepare",
            "offer_visit",
            "confirm_visit",
            "offer_record",
            "confirm_record",
            "offer_both",
            "confirm_both",
            "records",
            "scope"
          ],
          "description": "offer_* means the assistant is asking the user for execution permission. Asking for permission always uses offer_*, never confirm_*. confirm_* means the current user explicitly authorized execution of a matching still-pending prior offer. If pending_action_offer is absent/null, use offer_* for an action request. Refused, deferred or superseded offers cannot authorize execution. Interpret meaning, not keywords such as confirm or yes."
        },
        "format_version": {
          "const": 2,
          "description": "Natural patient-facing format. Omit for legacy payloads."
        },
        "reply": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "The complete natural assistant turn, including any focused questions. Evidence metadata is not the visible reply."
        },
        "confirmation_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "Only for confirm_*: exact full current user text explicitly granting execution permission for the current pending_action_offer. Asking the assistant to confirm or agreeing with a symptom summary is not execution consent. Omit for offer_*."
        },
        "confirmation_offer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Only for confirm_*: copy the existing matching pending_action_offer.run_id exactly. Never invent an id or use an empty string. If no pending offer exists, choose offer_* and omit all confirmation fields; do not recover a refused or expired offer from history."
        },
        "confirmation_has_new_details": {
          "type": "boolean",
          "description": "False only when the consenting user turn contains no new health details or corrections; omitted means retain the source."
        }
      },
      "required": [
        "speech",
        "questions",
        "unknowns",
        "claims",
        "intent"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "format_version"
            ]
          },
          "then": {
            "required": [
              "reply"
            ]
          }
        },
        {
          "if": {
            "required": [
              "format_version",
              "intent"
            ],
            "properties": {
              "intent": {
                "enum": [
                  "confirm_visit",
                  "confirm_record",
                  "confirm_both"
                ]
              }
            }
          },
          "then": {
            "required": [
              "confirmation_quote",
              "confirmation_offer_id"
            ]
          }
        }
      ]
    }
  }
}
