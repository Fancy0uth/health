{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healththread.local/schemas/tool-receipt.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tool": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "snapshot_revision": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at": {
      "type": "string"
    },
    "validation": {
      "const": "passed"
    }
  },
  "required": [
    "id",
    "owner",
    "tool",
    "run_id",
    "operation_id",
    "snapshot_revision",
    "recorded_at",
    "validation"
  ]
}
