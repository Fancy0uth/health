{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healththread.local/schemas/healththread_retrieve_context.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "maxLength": 1000
    },
    "episode_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 100
    },
    "source_offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Overview refresh only: selected-source page offset, default 0. Follow source_page.next_offset until null before staging. Cannot combine with source_ids."
    }
  },
  "required": []
}
