{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healththread.local/schemas/healththread_stage_candidates.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "minItems": 0,
      "maxItems": 100,
      "description": "Native JSON array of new candidate objects; never a JSON string. No operation_key/base_profile_revision wrapper inside this array."
    },
    "base_profile_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Copy context.snapshot_revision as an integer; outer tool field, not inside candidates."
    },
    "operation_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "description": "Copy the exact stable operation_key from the workflow input; outer tool field, never inside a candidate."
    },
    "record_dialogue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "missing_fields": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "症状表现",
              "开始时间",
              "身体部位",
              "频率",
              "持续时间",
              "程度",
              "影响",
              "用药",
              "过敏"
            ]
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 20000,
          "description": "Natural summary of supported current patient details, retaining uncertainty and corrections. Does not replace exact candidate evidence or assert medical verification.",
          "minLength": 1
        }
      },
      "required": [
        "questions",
        "missing_fields"
      ]
    },
    "record_source_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "description": "Natural record only: select currently valid authorized indexed_sentences. Send candidates:[] and nonempty record_dialogue.summary; optional health_observations must be exact snippets supported by the selected sentence. Server derives exact complete-sentence evidence. Never mix with manual candidates.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sentence_index": {
            "type": "integer",
            "minimum": 0
          },
          "health_observations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/health_observation"
            },
            "minItems": 0,
            "maxItems": 50
          }
        },
        "required": [
          "source_id",
          "sentence_index"
        ]
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      },
      "maxItems": 100
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "用 1–3 句通俗中文描述有来源的健康近况，保留重要时间、否认与变化范围。不得写 image_transcript/readable/uncertainties 等处理元数据或保存、核对等产品流程；patient_report 只称患者自述，不称已确认。区分医嘱计划与患者实际报告的执行时间，不把计划时长当成已执行时长。"
        },
        "regions": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "head_neck",
                  "chest",
                  "abdomen",
                  "back",
                  "limbs",
                  "systemic",
                  "other"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "description": "用 1–3 句通俗中文描述有来源的健康近况，保留重要时间、否认与变化范围。不得写 image_transcript/readable/uncertainties 等处理元数据或保存、核对等产品流程；patient_report 只称患者自述，不称已确认。区分医嘱计划与患者实际报告的执行时间，不把计划时长当成已执行时长。"
              },
              "status": {
                "enum": [
                  "reported",
                  "documented",
                  "improving",
                  "resolved",
                  "uncertain"
                ]
              },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "label",
              "summary",
              "status",
              "source_ids"
            ]
          },
          "description": "按资料支持的部位组织，每个部位 ID 只出现一次；同一部位的不同表现合为一张卡，保留各自时间和范围，未提及部位省略。"
        }
      },
      "required": [
        "summary",
        "regions"
      ],
      "description": "供患者阅读的身体近况综合；证据原文与结构化状态由其他字段保留。"
    },
    "document_source_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "description": "Document extraction: select authorized indexed_sentences and classify each sentence with field. Use candidates:[]; never mix nonempty record_source_refs or manual candidates. Exact complete evidence and literal annotations are reconstructed and strictly validated by the server. Provide a native overview object.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sentence_index": {
            "type": "integer",
            "minimum": 0
          },
          "health_observations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/health_observation"
            },
            "minItems": 0,
            "maxItems": 50
          },
          "field": {
            "enum": [
              "reported_text",
              "symptom",
              "diagnosis",
              "medication",
              "instruction",
              "allergy",
              "test",
              "observation"
            ]
          }
        },
        "required": [
          "source_id",
          "sentence_index",
          "field"
        ]
      }
    }
  },
  "required": [
    "candidates",
    "base_profile_revision",
    "operation_key"
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_text_version": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "page",
            "start",
            "end"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "source_text_version",
        "locator",
        "quote"
      ]
    },
    "effective_time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "interval",
            "relative",
            "unknown"
          ]
        },
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "enum": [
            null,
            "Asia/Shanghai",
            "UTC"
          ]
        },
        "anchor_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "raw",
        "precision",
        "start",
        "end",
        "timezone",
        "anchor_source_id"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "reported_text",
            "symptom",
            "diagnosis",
            "medication",
            "instruction",
            "allergy",
            "test",
            "observation"
          ]
        },
        "value": {
          "type": "string"
        },
        "assertion": {
          "enum": [
            "affirmed",
            "negated",
            "uncertain"
          ]
        },
        "temporal_scope": {
          "enum": [
            "current",
            "past",
            "unknown"
          ]
        },
        "effective_time": {
          "$ref": "#/$defs/effective_time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "proposal_kind": {
          "enum": [
            "new",
            "correction",
            "retraction"
          ]
        },
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "episode_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "health_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/health_observation"
          },
          "minItems": 0,
          "maxItems": 50
        }
      },
      "required": [
        "field",
        "value",
        "assertion",
        "temporal_scope",
        "effective_time",
        "evidence",
        "proposal_kind"
      ],
      "description": "All evidence quotes must exactly equal this candidate value; field/assertion/temporal_scope/effective_time are validated solely against that rendered value. Unrelated auxiliary evidence is rejected."
    },
    "health_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "body_site",
            "symptom",
            "onset",
            "course",
            "self_rating",
            "impact",
            "context",
            "associated",
            "measurement",
            "background"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "description": "Extractive metadata supported by this candidate sentence only. value, unit and observed_at must be exact supported snippets, preserving negation and uncertainty. No inferred scores, units, dates or diagnoses. Missing unit/time is omitted or null; recorded time is not event time."
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_index": {
          "type": "integer",
          "minimum": 0
        },
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "relation": {
          "enum": [
            "conflict",
            "update",
            "duplicate",
            "related"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "candidate_index",
        "fact_id",
        "revision",
        "relation",
        "reason"
      ],
      "description": "Compare against a currently confirmed same-owner fact actually retrieved in this run. candidate_index is the zero-based original candidates or record_source_refs or document_source_refs index. Explicit temporal change is update; simultaneous incompatible claims are conflict. Comparisons never replace facts automatically."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "record_source_refs"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "maxItems": 0
          },
          "record_dialogue": {
            "required": [
              "summary"
            ]
          }
        },
        "required": [
          "record_dialogue"
        ]
      }
    },
    {
      "if": {
        "required": [
          "document_source_refs"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "maxItems": 0
          },
          "record_source_refs": {
            "maxItems": 0
          }
        },
        "required": [
          "overview"
        ]
      }
    }
  ],
  "description": "Call with a native outer object: candidates is a native array, base_profile_revision is an outer integer copied from context.snapshot_revision, operation_key is the exact outer business key supplied for this run. Do not JSON.stringify candidates or put top-level metadata inside candidates.",
  "examples": [
    {
      "candidates": [],
      "base_profile_revision": 1,
      "operation_key": "COPY-INPUT-OPERATION-KEY",
      "comparisons": [],
      "overview": {
        "summary": "资料支持的概述，未提及部位不造正常。",
        "regions": []
      }
    }
  ]
}
