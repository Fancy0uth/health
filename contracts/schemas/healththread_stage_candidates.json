{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healththread.local/schemas/healththread_stage_candidates.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "base_profile_revision": {
      "type": "integer",
      "minimum": 1
    },
    "operation_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "record_dialogue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "missing_fields": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "症状表现",
              "开始时间",
              "身体部位",
              "频率",
              "持续时间",
              "程度",
              "影响",
              "用药",
              "过敏"
            ]
          }
        }
      },
      "required": [
        "questions",
        "missing_fields"
      ]
    }
  },
  "required": [
    "candidates",
    "base_profile_revision",
    "operation_key"
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_text_version": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "page",
            "start",
            "end"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "source_text_version",
        "locator",
        "quote"
      ]
    },
    "effective_time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "interval",
            "relative",
            "unknown"
          ]
        },
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "enum": [
            null,
            "Asia/Shanghai",
            "UTC"
          ]
        },
        "anchor_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "raw",
        "precision",
        "start",
        "end",
        "timezone",
        "anchor_source_id"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "reported_text",
            "symptom",
            "diagnosis",
            "medication",
            "instruction",
            "allergy",
            "test",
            "observation"
          ]
        },
        "value": {
          "type": "string"
        },
        "assertion": {
          "enum": [
            "affirmed",
            "negated",
            "uncertain"
          ]
        },
        "temporal_scope": {
          "enum": [
            "current",
            "past",
            "unknown"
          ]
        },
        "effective_time": {
          "$ref": "#/$defs/effective_time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "proposal_kind": {
          "enum": [
            "new",
            "correction",
            "retraction"
          ]
        },
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "episode_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "field",
        "value",
        "assertion",
        "temporal_scope",
        "effective_time",
        "evidence",
        "proposal_kind"
      ],
      "description": "All evidence quotes must exactly equal this candidate value; field/assertion/temporal_scope/effective_time are validated solely against that rendered value. Unrelated auxiliary evidence is rejected."
    }
  }
}
