{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healththread.local/schemas/candidate.json",
  "$ref": "#/$defs/candidate",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_text_version": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "page",
            "start",
            "end"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "source_text_version",
        "locator",
        "quote"
      ]
    },
    "effective_time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "interval",
            "relative",
            "unknown"
          ]
        },
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "enum": [
            null,
            "Asia/Shanghai",
            "UTC"
          ]
        },
        "anchor_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "raw",
        "precision",
        "start",
        "end",
        "timezone",
        "anchor_source_id"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "reported_text",
            "symptom",
            "diagnosis",
            "medication",
            "instruction",
            "allergy",
            "test",
            "observation"
          ]
        },
        "value": {
          "type": "string"
        },
        "assertion": {
          "enum": [
            "affirmed",
            "negated",
            "uncertain"
          ]
        },
        "temporal_scope": {
          "enum": [
            "current",
            "past",
            "unknown"
          ]
        },
        "effective_time": {
          "$ref": "#/$defs/effective_time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "proposal_kind": {
          "enum": [
            "new",
            "correction",
            "retraction"
          ]
        },
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "episode_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "health_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/health_observation"
          },
          "minItems": 0,
          "maxItems": 50
        }
      },
      "required": [
        "field",
        "value",
        "assertion",
        "temporal_scope",
        "effective_time",
        "evidence",
        "proposal_kind"
      ],
      "description": "All evidence quotes must exactly equal this candidate value; field/assertion/temporal_scope/effective_time are validated solely against that rendered value. Unrelated auxiliary evidence is rejected."
    },
    "health_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "body_site",
            "symptom",
            "onset",
            "course",
            "self_rating",
            "impact",
            "context",
            "associated",
            "measurement",
            "background"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "description": "Extractive metadata supported by this candidate sentence only. value, unit and observed_at must be exact supported snippets, preserving negation and uncertainty. No inferred scores, units, dates or diagnoses. Missing unit/time is omitted or null; recorded time is not event time."
    }
  }
}
